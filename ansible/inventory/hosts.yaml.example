# Voorbeeld-inventory - kopieer naar hosts.yaml en vul de echte node-namen/IP's
# in voor DC1 en DC2. Niet gevuld met aannames, want die namen kennen wij hier niet.
all:
  children:
    dc1_kubevirt_nodes:
      hosts:
        dc1-kube01:
          ansible_host: 10.1.0.11
        dc1-kube02:
          ansible_host: 10.1.0.12
        dc1-kube03:
          ansible_host: 10.1.0.13
    dc2_kubevirt_nodes:
      hosts:
        dc2-kube01:
          ansible_host: 10.2.0.11
        dc2-kube02:
          ansible_host: 10.2.0.12
        dc2-kube03:
          ansible_host: 10.2.0.13
